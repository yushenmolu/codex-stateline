# Local verification evidence and original-file backups
/Temp/
/.test-tmp/
/.task-backups/
/.stage-snapshot.json
*.log
*.before
*.bak

# Generated artwork and run artifacts. Everything under output/ is regenerable
# except the single finished SVG the legacy animation launcher ships with
# (scripts/open-pelican-animation.ps1 reads it from that fixed path).
/output/*
!/output/pelican-362f3c3d-animated.svg

